{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "es2024": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/out/**",
    "**/dist/**",
    "**/.turbo/**",
    "vendor/**",
    "prototype/**"
  ],
  "rules": {
    "no-console": "error",
    // 测试探针（decorate.ts 的构建计数器）需要一个全局名，双下划线是"内部探针"的显式标记
    "no-underscore-dangle": ["error", { "allow": ["__sepiaDecorateBuilds"] }],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    // `export {}` 是 TS 里「这是一个刻意为空的模块」的标准写法，
    // 五个包的 src/index.ts 都靠它占位。unicorn 这条规则针对的是 `import {} from 'x'`，
    // 对 export 侧是误判——关掉的是规则的误报，不是我们自己的纪律。
    "unicorn/require-module-specifiers": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}

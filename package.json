{
  "name": "sepia",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@opencode-ai/sdk": "1.18.13",
      "chokidar": "4.0.3",
      "jsonc-parser": "3.3.1",
      "@codemirror/commands": "^6.10.4",
      "@codemirror/lang-markdown": "^6.5.1",
      "@codemirror/language": "^6.12.4",
      "@codemirror/language-data": "^6.5.2",
      "@codemirror/search": "^6.7.1",
      "@codemirror/state": "^6.7.1",
      "@codemirror/view": "^6.43.7",
      "@lezer/common": "^1.5.2",
      "@lezer/highlight": "^1.2.3",
      "@lezer/markdown": "^1.7.2",
      "@playwright/test": "^1.62.1",
      "@swc/core": "^1.15.47",
      "@types/node": "^22.20.1",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@types/turndown": "^5.0.6",
      "@vitejs/plugin-react": "^5.2.0",
      "electron": "^43.2.0",
      "electron-builder": "^26.15.3",
      "electron-vite": "^5.0.0",
      "katex": "^0.18.1",
      "motion": "^13.1.0",
      "mermaid": "^11.12.0",
      "marked": "^18.0.9",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "remend": "1.3.0",
      "shiki": "^4.4.2",
      "@shikijs/langs": "^4.4.2",
      "turndown": "^7.2.4",
      "typescript": "^5.9.3",
      "vite": "^7.3.6",
      "vitest": "^4.1.10"
    }
  },
  "scripts": {
    "dev": "bun --filter @sepia/app dev",
    "build": "bun --filter @sepia/app build",
    "lint": "bun scripts/check-discipline.mjs && oxlint --quiet -c .oxlintrc.json packages scripts test",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "playwright test",
    "check": "bun scripts/check.mjs",
    "check:fast": "bun scripts/check.mjs --fast",
    "check:deps": "bun scripts/check-deps.mjs",
    "check:bridge": "bun scripts/check-bridge.mjs",
    "check:workspace": "bun scripts/check-workspace.mjs",
    "check:theme": "bun scripts/check-theme.mjs",
    "check:commands": "bun scripts/check-commands.mjs",
    "check:marks": "bun scripts/check-marks.mjs",
    "check:artifacts": "bun scripts/check-artifacts.mjs",
    "check:patches": "bun scripts/check-patches.mjs",
    "build:engine": "bun scripts/build-engine.ts"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "dependency-cruiser": "^18.1.1",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

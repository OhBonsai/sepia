{
  "name": "sepia",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@codemirror/commands": "^6.10.4",
      "@codemirror/state": "^6.7.1",
      "@codemirror/view": "^6.43.7",
      "@playwright/test": "^1.62.1",
      "@swc/core": "^1.15.47",
      "@types/node": "^22.20.1",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^5.2.0",
      "electron": "^43.2.0",
      "electron-builder": "^26.15.3",
      "electron-vite": "^5.0.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "typescript": "^5.9.3",
      "vite": "^7.3.6",
      "vitest": "^4.1.10"
    }
  },
  "scripts": {
    "dev": "bun --filter @sepia/app dev",
    "build": "bun --filter @sepia/app build",
    "lint": "bun scripts/check-discipline.mjs && oxlint --quiet",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "playwright test",
    "check": "bun scripts/check.mjs",
    "check:fast": "bun scripts/check.mjs --fast",
    "check:deps": "bun scripts/check-deps.mjs",
    "check:bridge": "bun scripts/check-bridge.mjs",
    "check:workspace": "bun scripts/check-workspace.mjs",
    "check:marks": "bun scripts/check-marks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "dependency-cruiser": "^18.1.1",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

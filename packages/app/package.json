{
  "name": "@sepia/app",
  "version": "0.0.0",
  "private": true,
  "description": "一张会越用越懂你的纸：单人、本地、git 打底的 markdown 笔记本",
  "homepage": "https://github.com/OhBonsai/sepia",
  "author": {
    "name": "OhBonsai",
    "email": "letbonsaibe@gmail.com"
  },
  "main": "out/main/index.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "ensure-electron": "node -e \"require('electron')\"",
    "predev": "bun ../../scripts/build-engine.ts",
    "dev": "bun run ensure-electron && electron-vite dev",
    "prebuild": "bun ../../scripts/build-engine.ts",
    "build": "electron-vite build",
    "start": "bun run ensure-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sepia/agent": "workspace:*",
    "@sepia/core": "workspace:*",
    "@sepia/editor": "workspace:*",
    "@sepia/ui": "workspace:*",
    "motion": "catalog:",
    "@shikijs/langs": "catalog:",
    "chokidar": "catalog:",
    "jsonc-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remend": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
